{
  // Written by Kone Tshivhinda & Claude
  // Cloudflare Workers Static Assets: serves the built site in ./dist. No Worker script needed.
  "name": "k-one-it-solutions-website",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  // Workers Builds runs `wrangler preview` on pull requests; it needs the block even when empty.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
