---
// Written by Kone Tshivhinda & Claude
import { Mail, Phone, MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, contact, formEndpoint } from '../config';
---

<Base
  title="Contact"
  description="Contact K-ONE IT SOLUTIONS in Johannesburg by email, phone or the contact form to discuss your project."
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-aurora absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative py-16 md:py-20">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">
        Let&rsquo;s talk about <span class="grad-text">your project</span>.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">Send a message, or reach out directly. A short description of the problem is plenty to start.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.15fr]">
      <div class="space-y-6">
        <ul class="space-y-4">
          <li class="card flex items-center gap-4 p-5">
            <span class="icon-tile"><Mail size={20} aria-hidden="true" /></span>
            <div>
              <p class="eyebrow">Email</p>
              <a href={`mailto:${contact.email}`} class="font-medium">{contact.email}</a>
            </div>
          </li>
          <li class="card flex items-center gap-4 p-5">
            <span class="icon-tile"><Phone size={20} aria-hidden="true" /></span>
            <div>
              <p class="eyebrow">Phone</p>
              <a href={contact.phoneHref} class="font-medium">{contact.phone}</a>
            </div>
          </li>
          <li class="card flex items-center gap-4 p-5">
            <span class="icon-tile"><MapPin size={20} aria-hidden="true" /></span>
            <div>
              <p class="eyebrow">Based in</p>
              <p class="font-medium">{site.location}</p>
            </div>
          </li>
        </ul>
        <div>
          <p class="eyebrow mb-3">Elsewhere</p>
          <SocialLinks />
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Send a message</h2>
        <form
          id="contact-form"
          class="mt-6 space-y-5"
          method="post"
          data-endpoint={formEndpoint}
          data-email={contact.email}
          novalidate
        >
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm focus:border-brand" />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm focus:border-brand" />
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium">How can I help?</label>
            <textarea id="message" name="message" rows="6" required class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-sm focus:border-brand"></textarea>
          </div>
          <!-- Honeypot: hidden from people, tempting to bots -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="_gotcha">Leave this empty</label>
            <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary">Send message</button>
            <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
          </div>
          <p class="text-xs text-muted">See the <a href="/privacy/">privacy notice</a> for how your details are used.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const setStatus = (msg: string, isError = false) => {
    if (!status) return;
    status.textContent = msg;
    status.className = `text-sm ${isError ? 'text-red-600 dark:text-red-400' : 'text-muted'}`;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    if (data.get('_gotcha')) return; // bot

    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email ?? '';

    if (endpoint) {
      setStatus('Sending…');
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setStatus('Thank you. Your message was sent and I will reply soon.');
      } catch {
        setStatus(`Sorry, that did not send. Please email ${email} directly.`, true);
      }
      return;
    }

    // No form service configured: open the visitor's own email app with the message filled in.
    const subject = encodeURIComponent(`Website enquiry from ${data.get('name')}`);
    const body = encodeURIComponent(`${data.get('message')}\n\nFrom: ${data.get('name')} <${data.get('email')}>`);
    setStatus('Opening your email app…');
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
