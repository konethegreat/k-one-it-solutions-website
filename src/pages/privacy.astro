---
// Written by Kone Tshivhinda & Claude
import Base from '../layouts/Base.astro';
import { site, contact, formEndpoint } from '../config';
---

<Base title="Privacy" description="How K-ONE IT SOLUTIONS handles personal information on this website.">
  <section class="section">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Privacy</p>
      <h1 class="mt-3 text-4xl font-bold">Privacy notice</h1>
      <p class="mt-4 text-muted">A short, plain-language summary of how this website treats personal information.</p>

      <div class="mt-10 space-y-8 leading-relaxed">
        <div>
          <h2 class="text-xl font-semibold">No tracking</h2>
          <p class="mt-2 text-muted">This site does not use cookies, analytics or advertising trackers. The only thing stored in your browser is your light or dark theme choice, and it never leaves your device.</p>
        </div>
        <div>
          <h2 class="text-xl font-semibold">If you contact me</h2>
          {
            formEndpoint ? (
              <p class="mt-2 text-muted">
                When you send the contact form, your name, email address and message are passed to a form service that delivers them to {site.name}. They are used only to reply to you and are not sold or shared for marketing.
              </p>
            ) : (
              <p class="mt-2 text-muted">
                The contact form opens your own email app with your message filled in, so nothing is collected by this website. If you email or phone, your details are used only to reply to you and are not sold or shared for marketing.
              </p>
            )
          }
        </div>
        <div>
          <h2 class="text-xl font-semibold">Links to other sites</h2>
          <p class="mt-2 text-muted">Links to GitHub, LinkedIn and other sites lead to services with their own privacy practices.</p>
        </div>
        <div>
          <h2 class="text-xl font-semibold">Your rights and questions</h2>
          <p class="mt-2 text-muted">
            To ask what I hold about you, or to have it deleted, email <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
