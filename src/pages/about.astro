---
// Written by Kone Tshivhinda & Claude
import { Image } from 'astro:assets';
import { ArrowRight, Clock, ExternalLink, MapPin } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Marquee from '../components/Marquee.astro';
import CtaBand from '../components/CtaBand.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portrait from '../assets/portrait.webp';
import { about } from '../data/about';
import { skillGroups } from '../data/content';
import { site, links } from '../config';

const marqueeItems = [...new Set(skillGroups.flatMap((group) => group.items))].slice(0, 16);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.founder,
  jobTitle: 'Founder and AI systems engineer',
  description:
    'AI systems engineer and full-stack developer in Johannesburg, founder of K-ONE IT SOLUTIONS.',
  url: new URL('/about/', Astro.site).href,
  image: new URL('/og-image.png', Astro.site).href,
  worksFor: {
    '@type': 'Organization',
    name: site.name,
    url: Astro.site?.href,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Johannesburg',
    addressCountry: 'ZA',
  },
  sameAs: [links.github, links.linkedin, links.portfolio],
  knowsLanguage: about.languages.map((language) => language.name),
};
---

<Base
  title="About Kone Tshivhinda"
  description="Kone Tshivhinda is the founder of K-ONE IT SOLUTIONS, an AI systems engineer and full-stack developer in Johannesburg. The principles, timeline and current work behind the studio."
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-blueprint absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid gap-12 py-16 md:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="eyebrow">
          <span class="text-brand">03</span>
          <span class="h-px w-8 bg-line" aria-hidden="true"></span>
          About
        </p>
        <h1 class="mt-5 max-w-3xl text-5xl sm:text-6xl">
          Engineer by trade, <em class="italic">builder by habit</em>.
        </h1>
        <div class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
          {about.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="btn btn-primary">Start a project <ArrowRight size={16} aria-hidden="true" /></a>
          <a href="/work/" class="btn btn-ghost">Read the dossiers</a>
        </div>

        <dl class="mt-10 grid max-w-2xl gap-5 border-t border-line pt-6 sm:grid-cols-3">
          <div>
            <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Based in</dt>
            <dd class="mt-1.5 flex items-center gap-1.5 text-sm">
              <MapPin size={14} class="text-brand" aria-hidden="true" />
              Johannesburg
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Status</dt>
            <dd class="mt-1.5 flex items-center gap-1.5 text-sm">
              <span class="status-dot" aria-hidden="true"></span>
              {about.availability}
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Reply time</dt>
            <dd class="mt-1.5 flex items-center gap-1.5 text-sm">
              <Clock size={14} class="text-brand" aria-hidden="true" />
              Two business days
            </dd>
          </div>
        </dl>
      </div>

      <figure class="mx-auto w-full max-w-sm" data-reveal>
        <div class="corner-ticks relative border border-line bg-surface p-2 shadow-[var(--shadow)]">
          <Image
            src={portrait}
            alt="Portrait of Kone Tshivhinda, founder of K-ONE IT SOLUTIONS"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 24rem, 90vw"
            loading="eager"
            class="aspect-[3/4] w-full object-cover"
          />
          <span class="stamp stamp-ok absolute left-5 top-5 bg-bg/90 backdrop-blur-sm">Founder</span>
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between gap-4 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-muted">
          <span>Kone Tshivhinda</span>
          <span>Johannesburg, ZA</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Principles -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        number="02"
        title="Four rules the work follows."
        lead="These are commitments, not slogans. Each one shows up in the architecture and in what the dossiers admit."
      />
      <ol class="mt-10 grid gap-5 md:grid-cols-2">
        {
          about.principles.map((principle, i) => (
            <li class="card flex h-full flex-col p-6 sm:p-7" data-reveal style={`--i:${i}`}>
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-display text-4xl text-brand">P{String(i + 1).padStart(2, '0')}</span>
                <span class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Principle</span>
              </div>
              <h3 class="mt-5 text-xl">{principle.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section border-y border-line bg-surface-2/40">
    <div class="container-x">
      <SectionHeading
        number="03"
        title="The path here."
        lead="Testing, support, founding engineering and now an independent studio. The thread is software that has to work in the real world."
      />
      <ol class="timeline mt-12 max-w-3xl" data-reveal>
        {
          about.timeline.map((entry) => (
            <li class="relative pb-10 pl-9 last:pb-0">
              <span class:list={['timeline-dot', entry.current && 'is-current']} aria-hidden="true"></span>
              <div class="flex flex-wrap items-center gap-3">
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted">{entry.when}</p>
                {entry.current && <span class="stamp stamp-ok">Current</span>}
              </div>
              <h3 class="mt-1.5 text-xl">{entry.role}</h3>
              <p class="text-sm font-medium text-brand">{entry.org}</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">{entry.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Currently building -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        number="04"
        title="Currently building."
        lead="Four products in different stages. The status comes from the repositories and the live deployments, not from how close a launch feels."
      />
      <ul class="mt-10 divide-y divide-line border-y border-line">
        {
          about.building.map((item, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a
                href={item.href}
                class="group grid gap-3 py-6 no-underline md:grid-cols-[2.5rem_1fr_auto] md:items-center md:gap-6"
              >
                <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted">
                  0{i + 1}
                </span>
                <div>
                  <h3 class="flex items-center gap-2 text-xl text-fg">
                    {item.title}
                    <ArrowRight
                      size={16}
                      class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-brand"
                      aria-hidden="true"
                    />
                  </h3>
                  <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted">{item.summary}</p>
                </div>
                <span class={`stamp ${item.tone === 'ok' ? 'stamp-ok' : 'stamp-warn'} md:justify-self-end`}>
                  {item.status}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-2xl text-sm text-muted">
        Live alpha means there is a URL and an invite list. In development means the architecture and source exist, but
        the product is not live. Each dossier explains the difference in detail.
      </p>
    </div>
  </section>

  <!-- Skills -->
  <section class="section border-y border-line bg-surface-2/40">
    <div class="container-x">
      <SectionHeading
        number="05"
        title="The toolbox."
        lead="Tools are chosen per project. These are the ones in daily use, not a list of everything that has ever been tried."
      />
    </div>
    <div class="mt-10">
      <Marquee items={marqueeItems} label="Daily stack" />
    </div>
    <div class="container-x mt-10">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          skillGroups.map((group, i) => (
            <div class="card p-6" data-reveal style={`--i:${i % 3}`}>
              <h3 class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">{group.title}</h3>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {group.items.map((item) => <li class="chip">{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Credentials and languages -->
  <section class="section">
    <div class="container-x grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
      <div class="card p-6 sm:p-8" data-reveal>
        <p class="eyebrow">Credentials</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Qualified, and still shipping.</h2>
        <ul class="mt-8 divide-y divide-line border-t border-line">
          {
            about.credentials.map((credential) => (
              <li class="py-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg">{credential.title}</h3>
                    <p class="mt-1 text-sm text-muted">{credential.detail}</p>
                  </div>
                  {credential.href && (
                    <a
                      href={credential.href}
                      target={credential.href.startsWith('http') ? '_blank' : undefined}
                      rel={credential.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="pill-link shrink-0"
                    >
                      {credential.href.startsWith('http') ? 'Verify' : 'View'}
                      {credential.href.startsWith('http') ? (
                        <ExternalLink size={13} aria-hidden="true" />
                      ) : (
                        <ArrowRight size={13} aria-hidden="true" />
                      )}
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-6">
        <div class="card p-6" data-reveal>
          <p class="eyebrow">Languages</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {
              about.languages.map((language) => (
                <li class="flex justify-between gap-4 border-b border-line pb-2.5 last:border-0 last:pb-0">
                  <span>{language.name}</span>
                  <span class="text-muted">{language.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card p-6" data-reveal>
          <p class="eyebrow">Based in</p>
          <p class="mt-3 flex items-center gap-2 text-lg">
            <MapPin size={17} class="text-brand" aria-hidden="true" />
            {about.location}
          </p>
          <p class="mt-2 text-sm text-muted">South African Standard Time, UTC+2. Remote work is normal.</p>
          <div class="mt-5 border-t border-line pt-4">
            <SocialLinks />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .timeline {
    position: relative;
  }
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
  }
  .timeline::before {
    background: var(--line);
  }
  .timeline::after {
    background: linear-gradient(var(--brand), var(--g2));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s;
  }
  .timeline.is-revealed::after {
    transform: scaleY(1);
  }
  .timeline-dot {
    position: absolute;
    left: 0;
    top: 7px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 2px solid var(--line);
    background: var(--bg);
  }
  .timeline-dot.is-current {
    border-color: var(--brand);
    background: var(--brand);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--brand) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::after {
      transform: scaleY(1);
      transition: none;
    }
  }
</style>
