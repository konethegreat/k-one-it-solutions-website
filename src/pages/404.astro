---
// Written by Kone Tshivhinda & Claude
import { ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';

const routes = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<Base
  title="Page not found"
  description="That page does not exist or has moved. Use the links to find the services, project dossiers or contact details for K-ONE IT SOLUTIONS."
  noindex
>
  <section class="relative overflow-hidden">
    <div class="grid-blueprint absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative py-20 md:py-28">
      <div class="corner-ticks relative mx-auto max-w-3xl border border-line bg-surface/80 p-8 backdrop-blur-sm sm:p-12">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-5">
          <p class="eyebrow">
            <span class="text-brand">ERR</span>
            <span class="h-px w-8 bg-line" aria-hidden="true"></span>
            Route not found
          </p>
          <span class="stamp stamp-warn">No route</span>
        </div>

        <p class="mt-8 font-display text-[7rem] leading-none text-brand sm:text-[10rem]">404</p>
        <h1 class="mt-2 text-4xl sm:text-5xl">This page is not in the system.</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          The address does not exist, or it has moved. Nothing is broken on your side.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary">Back to home <ArrowRight size={16} aria-hidden="true" /></a>
          <a href="/work/" class="btn btn-ghost">Browse the work</a>
        </div>

        <nav class="mt-10 border-t border-line pt-5" aria-label="Site sections">
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {
              routes.map((route) => (
                <li>
                  <a href={route.href} class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted hover:text-brand">
                    {route.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>
</Base>
