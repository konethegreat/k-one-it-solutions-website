---
// Written by Kone Tshivhinda & Claude
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="relative overflow-hidden">
    <div class="bg-aurora absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative py-24 text-center md:py-32">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-5xl font-bold"><span class="grad-text">Page not found</span></h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-muted">That page does not exist, or it has moved.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/contact/" class="btn btn-ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>
