---
// Written by Kone Tshivhinda & Claude
import { ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services, process, skillGroups } from '../data/content';
---

<Base
  title="Services"
  description="AI agents, RAG and document intelligence, web and mobile apps, cloud and DevOps, local and sovereign AI, and QA, from K-ONE IT SOLUTIONS in Johannesburg."
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-aurora absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative py-16 md:py-20">
      <p class="eyebrow">Services</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">
        What <span class="grad-text">K-ONE IT SOLUTIONS</span> builds.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Six focused services, each backed by shipped, public work. Every engagement starts with a clear scope and an honest estimate.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-5 md:grid-cols-2">
      {services.map((s) => <ServiceCard service={s} detailed />)}
    </div>
  </section>

  <section class="section border-y border-line bg-surface-2/60">
    <div class="container-x">
      <p class="eyebrow">Process</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">A simple, visible way of working.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <li class="card p-6">
              <p class="font-mono text-sm grad-text">{p.step}</p>
              <h3 class="mt-2 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Technology</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">The tools in daily use.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          skillGroups.map((g) => (
            <div class="card p-6">
              <h3 class="text-base font-semibold">{g.title}</h3>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {g.items.map((i) => <li class="chip">{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a href="/contact/" class="btn btn-primary">Discuss your project <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</Base>
