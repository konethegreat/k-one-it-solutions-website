---
// Written by Kone Tshivhinda & Claude
import { ExternalLink } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ProjectExplorer from '../components/ProjectExplorer';
import { allProjects, categories } from '../data/projects';
import { links } from '../config';
---

<Base
  title="Work"
  description="Every public project from K-ONE IT SOLUTIONS: AI agents, legal and civic tech, web apps and developer tools, with source code and live links."
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-aurora absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative py-16 md:py-20">
      <p class="eyebrow">Work</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">
        Everything built in the open, <span class="grad-text">in one place</span>.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        This list is generated from the public GitHub profile, so it stays in step with the code. Status labels say plainly what is live, what is a prototype and what is coursework.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <ProjectExplorer client:load projects={allProjects} categories={categories} />
      <p class="mt-12 text-sm text-muted">
        Only public repositories are listed. Some work is private and available as a walkthrough on request.
        <a href={links.github} target="_blank" rel="noopener noreferrer" class="ml-1 inline-flex items-center gap-1 font-medium">
          View the GitHub profile <ExternalLink size={13} aria-hidden="true" />
        </a>
      </p>
    </div>
  </section>
</Base>
