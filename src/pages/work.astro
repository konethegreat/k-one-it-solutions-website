---
// Written by Kone Tshivhinda & Claude
import { Image } from 'astro:assets';
import { ArrowRight, ExternalLink } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectExplorer from '../components/ProjectExplorer';
import { allProjects, categories } from '../data/projects';
import { dossiers } from '../data/dossiers';
import { links } from '../config';

const covers: Record<string, number> = { sajas: 0, clearcut: 2 };

const liveProducts = [
  {
    name: 'SA-JAS',
    note: 'Find vacancies, tailor the CV, guide the application.',
    href: links.sajas,
    status: 'Hosted alpha',
  },
  {
    name: 'ClearCut',
    note: 'Read a South African invoice and check every figure.',
    href: links.clearcut,
    status: 'Live alpha, invite only',
  },
  {
    name: 'MuniSolve ZA',
    note: 'Report a municipal fault and follow it on a live map.',
    href: links.munisolve,
    status: 'Live',
  },
  {
    name: 'Portfolio',
    note: 'The personal site and the rest of the public record.',
    href: links.portfolio,
    status: 'Live',
  },
  {
    name: 'UI Vault',
    note: 'A sourced index of interface patterns and their rights.',
    href: links.vault,
    status: 'Live',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work',
  description: 'Public projects, technical dossiers and live deployments from K-ONE IT SOLUTIONS.',
  url: new URL('/work/', Astro.site).href,
  hasPart: dossiers.map((d) => ({
    '@type': 'CreativeWork',
    name: d.title,
    url: new URL(`/work/${d.slug}/`, Astro.site).href,
  })),
};
---

<Base
  title="Work"
  description={`${dossiers.length} technical dossiers and every public project from K-ONE IT SOLUTIONS: AI agents, legal and civic tech, live deployments, source code and architecture decisions.`}
  jsonLd={jsonLd}
>
  <PageHero
    number="02"
    label="Work"
    title="Everything built in the open, in one place."
    lead={`${dossiers.length} projects get a full technical dossier: the problem, the architecture, the decisions and what is honestly working today. Below that, every public repository and every live deployment.`}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#dossiers" class="btn btn-primary">Open the dossiers <ArrowRight size={16} aria-hidden="true" /></a>
      <a href="#archive" class="btn btn-ghost">Browse the archive</a>
    </div>

    <aside slot="aside" class="corner-ticks border border-line bg-surface/75 p-5 backdrop-blur-sm">
      <p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">The record</p>
      <dl class="mt-4 divide-y divide-line">
        <div class="flex items-baseline justify-between gap-4 py-2.5">
          <dt class="text-sm text-muted">Technical dossiers</dt>
          <dd class="font-display text-2xl text-brand">{dossiers.length}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-2.5">
          <dt class="text-sm text-muted">Live deployments</dt>
          <dd class="font-display text-2xl text-brand">{liveProducts.length}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-2.5">
          <dt class="text-sm text-muted">Public repositories</dt>
          <dd class="font-display text-2xl text-brand">{allProjects.length}</dd>
        </div>
      </dl>
      <a href={links.github} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4 text-sm">
        GitHub profile <ExternalLink size={14} aria-hidden="true" />
      </a>
    </aside>
  </PageHero>

  <!-- Dossiers -->
  <section id="dossiers" class="section scroll-mt-20">
    <div class="container-x">
      <SectionHeading
        number="02"
        title={`${dossiers.length} projects, opened up.`}
        lead="Each dossier names the real components, quotes the architecture decisions and separates what is built from what is still a plan."
      />

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          dossiers.map((d, i) => {
            const shot = d.screenshots[covers[d.slug] ?? 0];
            return (
              <a
                href={`/work/${d.slug}/`}
                class="group card card-hover flex h-full flex-col overflow-hidden no-underline"
                data-reveal
                style={`--i:${i}`}
              >
                <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
                  {shot ? (
                    <Image
                      src={shot.src}
                      alt=""
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 1024px) 36rem, 92vw"
                      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                  ) : (
                    <div class="absolute inset-0 overflow-hidden bg-ink-bg text-ink-fg">
                      <div class="grid-blueprint absolute inset-0 opacity-30" aria-hidden="true" />
                      <span
                        class="pointer-events-none absolute -bottom-16 -right-6 select-none font-display text-[13rem] leading-none text-ink-fg/[0.06]"
                        aria-hidden="true"
                      >
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <div class="relative flex h-full flex-col justify-end p-5">
                        <p class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-ink-muted">
                          Architecture diagram inside
                        </p>
                        <p class="mt-2 font-mono text-[0.58rem] uppercase tracking-[0.16em] text-ink-muted">
                          Dossier {String(i + 1).padStart(2, '0')}
                        </p>
                        <p class="mt-1 font-display text-4xl leading-none sm:text-5xl">{d.title}</p>
                        <p class="mt-3 font-mono text-[0.58rem] uppercase tracking-[0.12em] text-ink-muted">
                          {d.stack.slice(0, 3).join(' / ')}
                        </p>
                      </div>
                    </div>
                  )}
                  <div class="absolute left-3 top-3">
                    <span class={`stamp stamp-${d.statusTone} bg-bg/85 backdrop-blur-sm`}>{d.statusLabel}</span>
                  </div>
                  {shot && (
                    <span class="absolute right-3 top-3 font-mono text-[0.58rem] uppercase tracking-[0.16em] text-white/90 mix-blend-difference">
                      Dossier {String(i + 1).padStart(2, '0')}
                    </span>
                  )}
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted">{d.codename}</p>
                  <h3 class="mt-2 flex items-center gap-2 text-2xl">
                    {d.title}
                    <ArrowRight
                      size={18}
                      class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-brand"
                      aria-hidden="true"
                    />
                  </h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{d.summary}</p>
                  <div class="mt-5 flex flex-wrap items-center gap-1.5">
                    <span class="chip">{d.year}</span>
                    <span class="chip">{d.licence}</span>
                    <span class="chip">{d.stack[0]}</span>
                  </div>
                  <span class="link-arrow mt-5 text-sm">
                    Read the dossier <ArrowRight size={15} aria-hidden="true" />
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Live products -->
  <section class="section band-ink">
    <div class="container-x">
      <SectionHeading
        number="03"
        title="Live, right now."
        lead="Every live address you can open today. ClearCut needs an invite, so its demo is the public door."
      />

      <div class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 xl:grid-cols-5">
        {
          liveProducts.map((p, i) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col justify-between gap-8 bg-surface p-5 no-underline transition-colors hover:bg-surface-2"
              data-reveal
              style={`--i:${i}`}
            >
              <div>
                <div class="flex items-start justify-between gap-2">
                  <span class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">
                    P{String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="stamp stamp-neutral">{p.status}</span>
                </div>
                <h3 class="mt-5 text-lg">{p.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{p.note}</p>
              </div>
              <div class="flex items-center justify-between gap-3 border-t border-line pt-3">
                <span class="truncate font-mono text-[0.6rem] text-muted">
                  {new URL(p.href).hostname}
                </span>
                <ExternalLink
                  size={14}
                  class="shrink-0 text-muted transition-colors group-hover:text-brand"
                  aria-hidden="true"
                />
              </div>
            </a>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-ink-muted">
        These links open in a new tab. Every product above is described as it is today, alpha labels included.
      </p>
    </div>
  </section>

  <!-- Explorer -->
  <section id="archive" class="section scroll-mt-20">
    <div class="container-x">
      <SectionHeading
        number="04"
        title="The full public archive."
        lead="This list is generated from the public GitHub profile, so it stays in step with the code. Status labels say what is live, what is a prototype and what is coursework."
      />

      <div class="mt-10">
        <ProjectExplorer client:load projects={allProjects} categories={categories} />
      </div>

      <div class="mt-12 grid gap-5 border-t border-line pt-8 md:grid-cols-[1.4fr_0.6fr] md:items-end">
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          Only public repositories are listed. Private client and product work is available as a walkthrough on request,
          under NDA where needed.
        </p>
        <a href={links.github} target="_blank" rel="noopener noreferrer" class="link-arrow text-sm md:justify-self-end">
          View the GitHub profile <ExternalLink size={14} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Base>
