---
// Written by Kone Tshivhinda & Claude
import { ArrowRight, Phone } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual';
import ProjectCard from '../components/ProjectCard';
import ServiceCard from '../components/ServiceCard.astro';
import { site, contact, links } from '../config';
import { services, principles } from '../data/content';
import { featured, projects } from '../data/projects';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: Astro.site?.href,
  image: new URL('/og-image.png', Astro.site).href,
  description: site.description,
  email: contact.email,
  telephone: contact.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Johannesburg', addressCountry: 'ZA' },
  founder: { '@type': 'Person', name: site.founder },
  sameAs: [links.github, links.linkedin, links.portfolio],
};

const proof = [
  { big: String(projects.length), label: 'public repositories on GitHub' },
  { big: 'IBM', label: 'Full Stack Developer Professional Certificate' },
  { big: 'NQF 6', label: 'Diploma in Information Technology' },
  { big: 'POPIA', label: 'aware engineering, by default' },
];
---

<Base title={site.name} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="bg-aurora absolute inset-0" aria-hidden="true"></div>
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-14 py-16 md:py-24 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="eyebrow flex items-center gap-2.5">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true"></span>
          Independent software studio / Johannesburg, ZA
        </p>
        <h1 class="mt-6 text-4xl font-bold sm:text-5xl lg:text-[3.6rem]">
          Software and AI systems that are <span class="grad-text">auditable</span>, accountable and built to last.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted">
          {site.name} designs and builds agentic AI, web and mobile apps, and cloud infrastructure for businesses that need software to work, and to be able to prove it.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/contact/" class="btn btn-primary">Start a project <ArrowRight size={16} aria-hidden="true" /></a>
          <a href="/work/" class="btn btn-ghost">See the work</a>
          <a href={contact.phoneHref} class="btn btn-ghost"><Phone size={16} aria-hidden="true" /> {contact.phone}</a>
        </div>
        <p class="mt-8 font-mono text-xs uppercase tracking-[0.2em] text-muted">&ldquo;{site.tagline}&rdquo;</p>
      </div>
      <HeroVisual client:load />
    </div>
  </section>

  <!-- Proof -->
  <section aria-label="At a glance" class="border-y border-line bg-surface/60">
    <ul class="container-x grid grid-cols-2 gap-6 py-8 md:grid-cols-4">
      {
        proof.map((p) => (
          <li>
            <p class="font-display text-3xl font-bold grad-text">{p.big}</p>
            <p class="mt-1 text-sm text-muted">{p.label}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Services</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">From first idea to live deployment, end to end.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
      <p class="mt-8">
        <a href="/services/" class="inline-flex items-center gap-2 font-semibold">
          See what is included in each service <ArrowRight size={16} aria-hidden="true" />
        </a>
      </p>
    </div>
  </section>

  <!-- Principles -->
  <section class="section border-y border-line bg-surface-2/60">
    <div class="container-x">
      <p class="eyebrow">How the work is done</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Four rules every system is held to.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          principles.map((p, i) => (
            <div class="card p-6 sm:p-7">
              <p class="font-mono text-xs text-muted">0{i + 1}</p>
              <h3 class="mt-2 text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Selected work</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-4xl">Systems that think, cite and hand over.</h2>
      <p class="mt-3 max-w-2xl text-muted">Every card links to public source code or a live site. Prototypes are labelled as prototypes.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="mt-8">
        <a href="/work/" class="inline-flex items-center gap-2 font-semibold">
          Browse all {projects.length} public repositories <ArrowRight size={16} aria-hidden="true" />
        </a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20">
    <div class="container-x">
      <div class="rounded-[1.75rem] p-px" style="background-image:linear-gradient(135deg,var(--d1),var(--d2),var(--d3))">
        <div class="rounded-[1.7rem] bg-surface px-6 py-12 text-center sm:px-12">
          <h2 class="mx-auto max-w-2xl text-3xl font-bold sm:text-4xl">Have a project in mind?</h2>
          <p class="mx-auto mt-3 max-w-xl text-muted">Tell me what you are trying to achieve and I will come back with a clear, honest plan.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/contact/" class="btn btn-primary">Get in touch <ArrowRight size={16} aria-hidden="true" /></a>
            <a href={`mailto:${contact.email}`} class="btn btn-ghost">{contact.email}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
