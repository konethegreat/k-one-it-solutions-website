---
// Written by Kone Tshivhinda & Claude
import { ArrowRight, Bot, Cloud, FileSearch, LayoutDashboard, ShieldCheck, Wrench } from '@lucide/astro';
import type { ServiceDetail } from '../data/services';

interface Props {
  service: ServiceDetail;
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
const icons = { bot: Bot, search: FileSearch, layout: LayoutDashboard, cloud: Cloud, shield: ShieldCheck, wrench: Wrench };
const Icon = icons[service.icon];
---

<article class="card card-hover flex h-full flex-col p-6 sm:p-7">
  <div class="flex items-start justify-between gap-4">
    <span class="icon-tile"><Icon size={22} aria-hidden="true" /></span>
    <span class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-muted">S{service.number}</span>
  </div>
  <h3 class="mt-5 text-xl">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{service.summary}</p>
  {
    detailed && (
      <ul class="mt-5 space-y-2.5 text-sm" aria-label="What is included">
        {service.points.map((p) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brand" aria-hidden="true" />
            <span>{p}</span>
          </li>
        ))}
      </ul>
    )
  }
  <a href={`/services/${service.id}/`} class="link-arrow mt-auto pt-6 text-sm">
    Explore this service <ArrowRight size={15} aria-hidden="true" />
  </a>
</article>
