---
// Written by Kone Tshivhinda & Claude
import { Image } from 'astro:assets';
import mark from '../assets/logo-mark.png';

interface Props {
  size?: number;
  showText?: boolean;
}
const { size = 38, showText = true } = Astro.props;
---

<span class="inline-flex items-center gap-3">
  <span
    class="grid place-items-center rounded-md bg-white ring-1 ring-line"
    style={`width:${size}px;height:${size}px`}
  >
    <Image src={mark} alt="" width={Math.round(size * 0.74)} height={Math.round(size * 0.74)} />
  </span>
  {
    showText && (
      <span class="flex flex-col leading-none">
        <span class="font-display text-xl leading-none">K-ONE</span>
        <span class="mt-1 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-muted">IT Solutions</span>
      </span>
    )
  }
</span>
