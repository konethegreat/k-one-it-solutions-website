---
// Written by Kone Tshivhinda & Claude
import { engagements, type EngagementId } from '../data/services';

interface Props {
  engagement: EngagementId;
  index?: string;
}
const { engagement, index } = Astro.props;
const model = engagements[engagement];
---

<div class="card flex h-full flex-col p-6 sm:p-7" data-reveal>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-xl">{model.title}</h3>
    {index && <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">{index}</span>}
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">{model.body}</p>
  <dl class="mt-5 space-y-4 border-t border-line pt-4 text-sm">
    <div>
      <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Suits</dt>
      <dd class="mt-1">{model.suits}</dd>
    </div>
    <div>
      <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">What happens next</dt>
      <dd class="mt-1">{model.next}</dd>
    </div>
  </dl>
</div>
