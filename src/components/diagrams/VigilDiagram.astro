---
// Written by Kone Tshivhinda & Claude
import DiagramFrame from './DiagramFrame.astro';
---
<DiagramFrame
  label="Architecture · Vigil"
  caption="Every request enters through the gateway and Warden before it reaches the ontology, data or AI planes. Relay carries signed bundles to sovereign and air-gapped targets."
  legend={[
    { name: 'Security surface', tone: 'brand' },
    { name: 'Service plane', tone: 'muted' },
    { name: 'Sovereign delivery', tone: 'ok' },
  ]}
>
  <svg class="dgm" viewBox="0 0 760 520" role="img" aria-labelledby="vigil-diagram-title">
    <title id="vigil-diagram-title">Vigil architecture: clients, Warden security kernel, ontology, AI and data planes, operator surfaces and sovereign delivery</title>
    <defs>
      <marker id="vigil-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)"></path>
      </marker>
    </defs>

    <text class="dgm-label" x="16" y="48">Clients</text>
    <rect class="dgm-box" x="16" y="60" width="118" height="52" rx="5"></rect>
    <text class="dgm-title" x="75" y="82" text-anchor="middle">Analyst</text>
    <text class="dgm-sub" x="75" y="98" text-anchor="middle">console</text>
    <rect class="dgm-box" x="16" y="124" width="118" height="52" rx="5"></rect>
    <text class="dgm-title" x="75" y="146" text-anchor="middle">AI agents</text>
    <text class="dgm-sub" x="75" y="162" text-anchor="middle">MCP tools</text>
    <rect class="dgm-box" x="16" y="188" width="118" height="52" rx="5"></rect>
    <text class="dgm-title" x="75" y="210" text-anchor="middle">Field</text>
    <text class="dgm-sub" x="75" y="226" text-anchor="middle">Android edge</text>

    <line class="dgm-line" x1="134" y1="86" x2="170" y2="86" marker-end="url(#vigil-arrow)"></line>
    <line class="dgm-line" x1="134" y1="150" x2="170" y2="150" marker-end="url(#vigil-arrow)"></line>
    <line class="dgm-line" x1="134" y1="214" x2="170" y2="214" marker-end="url(#vigil-arrow)"></line>

    <rect class="dgm-accent" x="170" y="70" width="106" height="220" rx="6"></rect>
    <text class="dgm-label" x="223" y="96" text-anchor="middle">Gateway</text>
    <text class="dgm-title" x="223" y="128" text-anchor="middle" font-size="15">Warden</text>
    <text class="dgm-sub" x="223" y="148" text-anchor="middle">security kernel</text>
    <line x1="188" y1="160" x2="258" y2="160" stroke="var(--line)" stroke-width="1"></line>
    <text class="dgm-sub" x="223" y="180" text-anchor="middle">authority checked</text>
    <text class="dgm-sub" x="223" y="194" text-anchor="middle">before data moves</text>
    <text class="dgm-sub" x="223" y="222" text-anchor="middle">reads, writes and</text>
    <text class="dgm-sub" x="223" y="236" text-anchor="middle">inference</text>

    <path class="dgm-line" d="M276 130 H293 V103 H310" marker-end="url(#vigil-arrow)"></path>
    <line class="dgm-line" x1="276" y1="190" x2="310" y2="225" marker-end="url(#vigil-arrow)"></line>
    <path class="dgm-line" d="M276 250 H293 V347 H310" marker-end="url(#vigil-arrow)"></path>

    <rect class="dgm-box" x="310" y="48" width="214" height="110" rx="6"></rect>
    <text class="dgm-label" x="326" y="70">Ontology plane</text>
    <text class="dgm-title" x="326" y="96" font-size="15">Core</text>
    <text class="dgm-sub" x="326" y="118">Object sets · action engine · outbox</text>
    <text class="dgm-sub" x="326" y="134">Indexing · traversal · lineage · audit</text>

    <line class="dgm-line" x1="417" y1="158" x2="417" y2="170" marker-end="url(#vigil-arrow)"></line>

    <rect class="dgm-box" x="310" y="170" width="214" height="110" rx="6"></rect>
    <text class="dgm-label" x="326" y="192">AI plane</text>
    <text class="dgm-title" x="326" y="218" font-size="15">Mind</text>
    <text class="dgm-sub" x="326" y="240">Model gateway · agents · MCP</text>
    <text class="dgm-sub" x="326" y="256">Entity resolution · document AI</text>

    <line class="dgm-line" x1="417" y1="280" x2="417" y2="292" marker-end="url(#vigil-arrow)"></line>

    <rect class="dgm-box" x="310" y="292" width="214" height="110" rx="6"></rect>
    <text class="dgm-label" x="326" y="314">Data plane</text>
    <text class="dgm-title" x="326" y="340" font-size="15">Forge</text>
    <text class="dgm-sub" x="326" y="362">Connectors · Iceberg datasets</text>
    <text class="dgm-sub" x="326" y="378">Transforms · sync</text>

    <line class="dgm-line" x1="524" y1="103" x2="580" y2="103" marker-end="url(#vigil-arrow)"></line>
    <rect class="dgm-box" x="580" y="48" width="164" height="110" rx="6"></rect>
    <text class="dgm-label" x="596" y="70">Operator surfaces</text>
    <text class="dgm-title" x="596" y="96" font-size="14">Cockpit + Field</text>
    <text class="dgm-sub" x="596" y="118">Next.js workspace</text>
    <text class="dgm-sub" x="596" y="134">Android edge agent</text>

    <line class="dgm-line" x1="524" y1="347" x2="580" y2="347" marker-end="url(#vigil-arrow)"></line>
    <rect class="dgm-ok" x="580" y="292" width="164" height="110" rx="6"></rect>
    <text class="dgm-label" x="596" y="314">Sovereign delivery</text>
    <text class="dgm-title" x="596" y="340" font-size="15">Relay</text>
    <text class="dgm-sub" x="596" y="362">Signed bundles</text>
    <text class="dgm-sub" x="596" y="378">Colocation · on-prem · air-gap</text>

    <rect class="dgm-band" x="16" y="430" width="728" height="60" rx="5"></rect>
    <text class="dgm-sub" x="32" y="454">Every read, write and inference passes through Warden before it reaches data or a model.</text>
    <text class="dgm-sub" x="32" y="472">Default topology: South African colocation, customer premises or an air-gapped appliance.</text>
  </svg>
</DiagramFrame>
