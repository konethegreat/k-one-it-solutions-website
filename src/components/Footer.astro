---
// Written by Kone Tshivhinda & Claude
import { ArrowUpRight, Mail, MapPin, Phone } from '@lucide/astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { contact, links, nav, site } from '../config';

const year = new Date().getFullYear();
const liveWork = [
  { label: 'SA-JAS', href: links.sajas, note: 'Hosted alpha' },
  { label: 'ClearCut', href: links.clearcut, note: 'Live alpha' },
  { label: 'MuniSolve ZA', href: links.munisolve, note: 'Live demo' },
  { label: 'Portfolio', href: links.portfolio, note: 'Personal site' },
  { label: 'UI Vault', href: links.vault, note: 'Reference index' },
];
---

<footer class="mt-8 border-t border-line bg-surface-2/40">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.5fr_0.8fr_1fr_1.1fr]">
    <div class="space-y-4">
      <Logo />
      <p class="max-w-sm text-sm leading-relaxed text-muted">
        {site.tagline} An independent software studio building AI systems, apps and infrastructure that show their working.
      </p>
      <p class="flex items-center gap-2 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted">
        <span class="status-dot" aria-hidden="true"></span>
        Available for new work
      </p>
      <SocialLinks />
    </div>

    <nav aria-label="Footer" class="space-y-3">
      <p class="eyebrow">Explore</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="text-fg no-underline hover:underline">Home</a></li>
        {nav.map((item) => <li><a href={item.href} class="text-fg no-underline hover:underline">{item.label}</a></li>)}
        <li><a href="/privacy/" class="text-fg no-underline hover:underline">Privacy</a></li>
      </ul>
    </nav>

    <div class="space-y-3">
      <p class="eyebrow">Live work</p>
      <ul class="space-y-2 text-sm">
        {
          liveWork.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-1.5 text-fg no-underline hover:underline"
              >
                {item.label}
                <span class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-muted">{item.note}</span>
                <ArrowUpRight size={12} class="text-muted" aria-hidden="true" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-3">
      <p class="eyebrow">Get in touch</p>
      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-2.5">
          <Mail size={15} class="text-muted" aria-hidden="true" />
          <a href={`mailto:${contact.email}`} class="text-fg no-underline hover:underline">{contact.email}</a>
        </li>
        <li class="flex items-center gap-2.5">
          <Phone size={15} class="text-muted" aria-hidden="true" />
          <a href={contact.phoneHref} class="text-fg no-underline hover:underline">{contact.phone}</a>
        </li>
        <li class="flex items-center gap-2.5 text-muted">
          <MapPin size={15} aria-hidden="true" />
          {site.location}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line py-5">
    <div class="container-x flex flex-col gap-2 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p class="max-w-xl sm:text-right">
        Built with Astro. Circular navigation inspired by Kaif UI on 21st.dev, implemented from scratch.
      </p>
    </div>
  </div>
</footer>
